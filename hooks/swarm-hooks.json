{
  "hooks": [
    {
      "id": "herdr-app-status",
      "mode": "Async",
      "persistent": true,
      "command": "python3",
      "args": [
        "-I",
        "-S",
        "-u",
        "<MUX_HOME>/Hooks/herdr-app-bridge.py"
      ],
      "when": {
        "event": [
          "session_start",
          "user_input",
          "agent_turn_start",
          "tool_call",
          "tool_result",
          "tool_denied",
          "delegation",
          "delegation_end",
          "job_start",
          "job_end",
          "compaction",
          "turn_end",
          "turn_complete",
          "task_complete",
          "session_end"
        ]
      },
      "timeoutSeconds": 10
    }
  ]
}
