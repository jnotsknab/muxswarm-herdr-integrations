{
  "global": {
    "ctrl-alt-3": "layout.switch:graph",
    "ctrl-alt-4": "layout.switch:board",
    "ctrl-alt-5": "layout.switch:wall",
    "ctrl-alt-6": "layout.switch:ops",
    "ctrl-alt-7": "layout.switch:zen",
    "ctrl-alt-shift-1": "layout.switch:mux-lead",
    "ctrl-alt-shift-2": "layout.switch:mux-swarm",
    "ctrl-alt-shift-3": "layout.switch:mux-review",
    "ctrl-alt-shift-4": "layout.switch:mux-zen"
  },
  "layout:graph": {
    "ctrl-shift-g": "layout.toggle:graph",
    "ctrl-shift-m": "layout.toggle:muxbar",
    "ctrl-shift-f": "layout.toggle:panel"
  },
  "layout:board": {
    "ctrl-shift-g": "layout.toggle:board",
    "ctrl-shift-m": "layout.toggle:muxbar"
  },
  "layout:ops": {
    "ctrl-shift-g": "layout.toggle:ops"
  },
  "layout:wall": {
    "ctrl-shift-m": "layout.toggle:muxbar"
  }
}
