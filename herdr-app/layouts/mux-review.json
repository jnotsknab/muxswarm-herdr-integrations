{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "theme": "paper",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "workspace-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "agents-mux"
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 69
          },
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 42
          },
          "window_drag": true,
          "content": {
            "mod": "tabs"
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 10,
                  "background": "background",
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "height": 30,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              },
              "size": {
                "weight": 1.1
              }
            },
            {
              "id": "side",
              "type": "column",
              "gap": 8,
              "size": {
                "weight": 1
              },
              "children": [
                {
                  "id": "follow",
                  "type": "block",
                  "size": {
                    "weight": 1.4
                  },
                  "radius": 10,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "content": {
                    "mod": "mux-follow"
                  }
                },
                {
                  "id": "changes",
                  "type": "block",
                  "size": {
                    "weight": 1
                  },
                  "radius": 10,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "content": {
                    "mod": "changes"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "muxbar",
          "type": "block",
          "size": {
            "px": 44
          },
          "radius": 8,
          "border": {
            "width": 1,
            "color": "border"
          },
          "content": {
            "mod": "muxbar"
          }
        },
        {
          "id": "looks",
          "type": "block",
          "size": {
            "px": 30
          },
          "radius": 8,
          "border": {
            "width": 1,
            "color": "border"
          },
          "content": {
            "mod": "looks",
            "props": {
              "look": "paper"
            }
          }
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 28
          },
          "content": {
            "mod": "workspace-status"
          }
        }
      ]
    }
  ]
}
