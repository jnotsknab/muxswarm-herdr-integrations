{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "theme": "ink",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "workspace-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "agents-mux"
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 69
          },
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 42
          },
          "window_drag": true,
          "content": {
            "mod": "tabs"
          }
        },
        {
          "id": "wall-body",
          "type": "column",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "wall-bar",
              "type": "block",
              "size": {
                "px": 24
              },
              "content": {
                "mod": "wall"
              }
            },
            {
              "id": "wall-empty",
              "type": "block",
              "content": {
                "mod": "wall",
                "props": {
                  "empty": true
                }
              }
            }
          ]
        },
        {
          "id": "muxbar",
          "type": "block",
          "size": {
            "px": 44
          },
          "radius": 8,
          "border": {
            "width": 1,
            "color": "border"
          },
          "content": {
            "mod": "muxbar"
          }
        },
        {
          "id": "looks",
          "type": "block",
          "size": {
            "px": 30
          },
          "radius": 8,
          "border": {
            "width": 1,
            "color": "border"
          },
          "content": {
            "mod": "looks",
            "props": {
              "look": "ink"
            }
          }
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 28
          },
          "content": {
            "mod": "workspace-status"
          }
        }
      ]
    }
  ]
}
