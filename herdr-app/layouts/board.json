{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 42
          },
          "window_drag": true,
          "content": {
            "mod": "tabs"
          }
        },
        {
          "id": "board-split",
          "type": "column",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "board",
              "type": "block",
              "content": {
                "mod": "board"
              },
              "size": {
                "weight": 1.2
              },
              "min": 180
            },
            {
              "id": "main",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 160,
              "radius": 10,
              "border": {
                "width": 1,
                "color": "border"
              },
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 10,
                  "background": "background",
                  "lone": true,
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "height": 30,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            }
          ]
        },
        {
          "id": "muxbar",
          "type": "block",
          "size": {
            "px": 44
          },
          "border": {
            "width": 1,
            "color": "border"
          },
          "radius": 8,
          "content": {
            "mod": "muxbar"
          }
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 28
          },
          "content": {
            "mod": "workspace-status"
          }
        }
      ]
    }
  ],
  "theme": "ink",
  "preview": "layouts/board.svg"
}
